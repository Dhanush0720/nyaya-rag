# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Add your IP in Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DB=RAG

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Check these names against the current Gemini docs; change them here if Google renames a model.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_GEN_MODEL=gemini-2.5-flash
EMBED_DIM=768

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
